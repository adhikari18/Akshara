{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akshara.dev/schema/letter.schema.json",
  "title": "AksharaDevanagariLetterStrokeSchema",
  "description": "Declarative vector stroke-order, waypoint trajectory, topological rule, and phonetic metadata schema for Nepali Devanagari characters.",
  "type": "object",
  "required": [
    "id",
    "character",
    "unicode",
    "category",
    "phonetics",
    "viewBox",
    "shirorekha",
    "strokes",
    "vocabulary"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "Canonical ASCII identifier for the Devanagari character (e.g., 'ka', 'kha', 'a')."
    },
    "character": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4,
      "description": "UTF-8 Devanagari glyph (e.g., 'क', 'ख', 'अ')."
    },
    "unicode": {
      "type": "string",
      "pattern": "^U\\+[0-9A-F]{4}(\\s+U\\+[0-9A-F]{4})*$",
      "description": "Unicode codepoint representation (e.g., 'U+0915')."
    },
    "category": {
      "type": "string",
      "enum": ["swor", "vyanjan", "samyukta"],
      "description": "Devanagari character class: 'swor' (vowel), 'vyanjan' (consonant), or 'samyukta' (conjunct)."
    },
    "varga": {
      "type": "string",
      "description": "Paninian articulatory place of articulation (e.g., 'Kanthya (Velar)', 'Talavya (Palatal)')."
    },
    "phonetics": {
      "type": "object",
      "required": ["romanized", "ipa", "nepaliName", "audioPrompt", "articulationTip"],
      "additionalProperties": false,
      "properties": {
        "romanized": {
          "type": "string",
          "description": "Standard romanized transliteration (e.g., 'ka')."
        },
        "ipa": {
          "type": "string",
          "description": "International Phonetic Alphabet transcription (e.g., '/kʌ/')."
        },
        "nepaliName": {
          "type": "string",
          "description": "Traditional Nepali school recitation name (e.g., 'कपुरी क')."
        },
        "audioPrompt": {
          "type": "string",
          "description": "Canonical speech synthesis text or audio asset key."
        },
        "articulationTip": {
          "type": "string",
          "description": "Child-friendly pronunciation guide for diaspora and early learners."
        }
      }
    },
    "viewBox": {
      "type": "object",
      "required": ["width", "height", "shirorekhaY", "baselineY"],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number",
          "const": 300,
          "description": "Canonical normalized coordinate width (300 units)."
        },
        "height": {
          "type": "number",
          "const": 300,
          "description": "Canonical normalized coordinate height (300 units)."
        },
        "shirorekhaY": {
          "type": "number",
          "minimum": 40,
          "maximum": 100,
          "description": "Y-coordinate of the horizontal Shirorekha headline bar."
        },
        "baselineY": {
          "type": "number",
          "minimum": 200,
          "maximum": 270,
          "description": "Y-coordinate of the lower character baseline."
        }
      }
    },
    "shirorekha": {
      "type": "object",
      "required": ["enforcedLast", "startX", "endX", "y"],
      "additionalProperties": false,
      "properties": {
        "enforcedLast": {
          "type": "boolean",
          "const": true,
          "description": "Devanagari topological invariant: the Shirorekha top bar must always be drawn as the final stroke."
        },
        "startX": {
          "type": "number",
          "description": "Left-most X of the headline (start of the first segment when split)."
        },
        "endX": {
          "type": "number",
          "description": "Right-most X of the headline (end of the last segment when split)."
        },
        "y": { "type": "number" },
        "segments": {
          "type": "array",
          "minItems": 2,
          "description": "Optional split/partial headline spans, ordered left to right. Used by letters with an open upper-left loop (ख, ग, ण, थ, ध, भ, श) whose Shirorekha leaves a gap so the glyph is not confused with another letter (ध vs घ, भ vs म). Omit for a single continuous bar from startX to endX. The first segment must start at startX, the last must end at endX, and the Shirorekha stroke's svgPath must contain one subpath (M ...) per segment.",
          "items": {
            "type": "object",
            "required": ["startX", "endX"],
            "additionalProperties": false,
            "properties": {
              "startX": { "type": "number", "minimum": 0, "maximum": 300 },
              "endX": { "type": "number", "minimum": 0, "maximum": 300 }
            }
          }
        }
      }
    },
    "strokes": {
      "type": "array",
      "minItems": 2,
      "description": "Ordered sequence of vector strokes required to construct the glyph.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "type",
          "label",
          "nepaliInstruction",
          "englishInstruction",
          "svgPath",
          "directionHint",
          "toleranceRadius",
          "waypoints"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique stroke identifier (e.g., 'ka-stroke-1')."
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based sequential order of the stroke."
          },
          "type": {
            "type": "string",
            "enum": ["loop", "curve", "diagonal", "stem", "shirorekha"],
            "description": "Topological stroke classification: body/loop components first, vertical stem (Khadi Pai) second, Shirorekha strictly last."
          },
          "label": {
            "type": "string",
            "description": "Human-readable name of the stroke segment."
          },
          "nepaliInstruction": {
            "type": "string",
            "description": "Pedagogical instruction in Nepali."
          },
          "englishInstruction": {
            "type": "string",
            "description": "Pedagogical instruction in English."
          },
          "svgPath": {
            "type": "string",
            "minLength": 5,
            "description": "SVG path d-attribute in the 300x300 coordinate frame."
          },
          "directionHint": {
            "type": "string",
            "enum": [
              "counter-clockwise-loop",
              "clockwise-loop",
              "top-to-bottom",
              "left-to-right",
              "down-and-right-curve",
              "diagonal-down-right",
              "diagonal-down-left"
            ]
          },
          "toleranceRadius": {
            "type": "number",
            "minimum": 12,
            "maximum": 60,
            "description": "Base Euclidean hit radius in coordinate units (scaled adaptively for child motor jitter)."
          },
          "waypoints": {
            "type": "array",
            "minItems": 3,
            "description": "Ordered sequence of checkpoints (x, y) the pointer must traverse in order.",
            "items": {
              "type": "object",
              "required": ["index", "x", "y"],
              "additionalProperties": false,
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 300
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 300
                },
                "label": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "vocabulary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["word", "romanized", "meaning", "emoji"],
        "additionalProperties": false,
        "properties": {
          "word": { "type": "string" },
          "romanized": { "type": "string" },
          "meaning": { "type": "string" },
          "emoji": { "type": "string" }
        }
      }
    }
  }
}

